[Unit]
Description=konstantinosdroulias.com (Django)
After=network.target

[Service]
User=kd
Group=www-data
WorkingDirectory=/srv/konstantinosdroulias/app
EnvironmentFile=/srv/konstantinosdroulias/.env
RuntimeDirectory=konstantinosdroulias
RuntimeDirectoryMode=0750
ExecStart=/srv/konstantinosdroulias/venv/bin/gunicorn config.wsgi:application --workers 2 --bind unix:/run/konstantinosdroulias/app.sock --umask 007 --access-logfile - --timeout 60
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/konstantinosdroulias/data

[Install]
WantedBy=multi-user.target
